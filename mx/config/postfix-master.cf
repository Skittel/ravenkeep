# --- ravenkeep begin (managed by mx/deploy.sh) ---
submission inet n       -       y       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=reject_unauth_destination
  -o smtpd_recipient_restrictions=reject_non_fqdn_recipient,permit_sasl_authenticated,reject
submissions inet n      -       y       -       -       smtpd
  -o syslog_name=postfix/submissions
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=reject_unauth_destination
  -o smtpd_recipient_restrictions=reject_non_fqdn_recipient,permit_sasl_authenticated,reject
rk-policy unix  -       n       n       -       0       spawn
  user=ravenkeep argv=/opt/ravenkeep/mx/bin/rk-policy
ravenkeep unix  -       n       n       -       10      pipe
  flags=Rq user=ravenkeep argv=/opt/ravenkeep/mx/bin/rk-deliver sender=${sender} recipient=${recipient} client_address=${client_address} client_helo=${client_helo} sasl_username=${sasl_username} queue_id=${queue_id}
# --- ravenkeep end ---
