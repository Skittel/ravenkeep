#!/usr/bin/python3 -I
"""Postfix pipe delivery: classify the message and store it in the local spool.

Every message for a Ravenkeep domain is accepted and stored completely (decision E-007), so that
sender details are always available and nothing is lost while a sender is not yet approved.

Called once per recipient with key=value arguments:
  sender= recipient= client_address= client_hostname= client_helo= sasl_username= queue_id=

Status (field "status"):
  accepted  authenticated device, or approved sender whose SPF/DKIM passes and aligns
  rejected  approved sender, but SPF/DKIM check failed (see "reasons")
  pending   sender not on the allow-list yet
  blocked   sender on the block-list

Exit 0 = stored, exit 75 (EX_TEMPFAIL) = Postfix retries later; an internal error never loses
or bounces a message.
"""
import email
import email.header
import email.policy
import email.utils
import os
import sys
import traceback

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from ravenkeep_mx import intake, senderauth  # noqa: E402
from ravenkeep_mx.dnsclient import DNSClient  # noqa: E402

EX_TEMPFAIL = 75


def parse_args(argv):
    args = {}
    for item in argv:
        key, _, value = item.partition("=")
        args[key] = value
    return args


def decoded(value):
    """Decode an RFC 2047 header value to a plain string (None if missing)."""
    if value is None:
        return None
    try:
        return str(email.header.make_header(email.header.decode_header(str(value))))
    except Exception:  # noqa: BLE001 – keep the raw value if it cannot be decoded
        return str(value)


def header_summary(msg):
    """Visible headers shown in the UI, also for rejected/pending messages."""
    from_addresses = email.utils.getaddresses([str(h) for h in msg.get_all("From", [])])
    return {
        "from": decoded(msg.get("From")),
        "from_address": from_addresses[0][1].lower() if from_addresses else None,
        "to": decoded(msg.get("To")),
        "subject": decoded(msg.get("Subject")),
        "date": msg.get("Date"),
        "message_id": msg.get("Message-ID"),
    }


def classify(args, raw, msg, headers, dnsc):
    """Return the status fields for a message received on the public MX."""
    envelope_sender, header_from = args.get("sender", ""), headers["from_address"] or ""
    check = senderauth.evaluate(dnsc, raw, msg, args.get("client_address", ""), envelope_sender,
                                args.get("client_helo", ""))
    result = {"auth_verdict": check["verdict"], "reasons": check["reasons"],
              "auth": {k: check[k] for k in ("spf", "dkim", "from_domain", "alignment")}}

    blocked = intake.find_match(intake.read_sender_list(intake.BLOCKED_FILE), envelope_sender, header_from)
    if blocked:
        return {**result, "status": "blocked", "list_match": blocked}
    allowed = intake.find_match(intake.read_sender_list(intake.ALLOWED_FILE), envelope_sender, header_from)
    if not allowed:
        return {**result, "status": "pending", "list_match": None}
    return {**result, "status": "accepted" if check["verdict"] == "accepted" else "rejected",
            "list_match": allowed}


def main():
    args = parse_args(sys.argv[1:])
    raw = sys.stdin.buffer.read()
    msg = email.message_from_bytes(raw, policy=email.policy.compat32)
    dnsc = DNSClient()
    client_ip = args.get("client_address", "").removeprefix("IPv6:")  # Postfix marks IPv6 this way
    headers = header_summary(msg)

    metadata = {
        "envelope": {"sender": args.get("sender", ""), "recipient": args.get("recipient", "")},
        "client": {"address": client_ip, "hostname": args.get("client_hostname", ""),
                   "ptr": dnsc.reverse(client_ip) if client_ip else [], "helo": args.get("client_helo", "")},
        "headers": headers,
        "queue_id": args.get("queue_id", ""),
        "size": len(raw),
    }
    if args.get("sasl_username"):
        # Authenticated submission: the SMTP login identifies the device; no sender checks needed.
        metadata.update(mode="auth", sasl_username=args["sasl_username"], status="accepted", reasons=[])
    else:
        metadata.update(mode="mx", **classify(args, raw, msg, headers, dnsc))

    entry_id = intake.spool_message(raw, metadata)
    print(f"stored {entry_id} status={metadata['status']}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:  # noqa: BLE001
        traceback.print_exc()
        sys.exit(EX_TEMPFAIL)
