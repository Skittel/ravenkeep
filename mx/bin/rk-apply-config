#!/usr/bin/python3 -I
"""Apply a config bundle delivered by the Ravenkeep web app (decision E-009). Runs as root,
started by the systemd path unit when <data>/config-incoming/manifest.json appears.

The bundle is validated completely before anything is installed:
  - only known file names, sha256 of every file must match the manifest
  - syntax check per file type
On error nothing changes: the last valid config stays active and the error is reported in
<data>/config-status.json, which the web app reads back.
"""
import hashlib
import ipaddress
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from ravenkeep_mx import intake  # noqa: E402

INCOMING_DIR = os.path.join(intake.DATA_DIR, "config-incoming")
STATUS_FILE = os.path.join(intake.DATA_DIR, "config-status.json")
DOMAIN_RE = re.compile(r"^(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+(?:[a-z]{2,63}|xn--[a-z0-9-]{1,59})$")
LOCAL_RE = re.compile(r'^[^\s@"]{1,64}$')
MAX_FILE_SIZE = 5 * 1024 * 1024


def validate_sender_list(text):
    """Every non-comment line: <domain or address> [envelope|header]."""
    for number, line in enumerate(text.splitlines(), 1):
        parts = line.split("#", 1)[0].split()
        if not parts:
            continue
        if len(parts) > 2 or (len(parts) == 2 and parts[1] not in intake.MATCH_TARGETS):
            raise ValueError(f"line {number}: expected '<pattern> [envelope|header]'")
        pattern = parts[0]
        local, _, domain = pattern.rpartition("@")
        if (pattern.count("@") > 1) or ("@" in pattern and not LOCAL_RE.match(local)) or not DOMAIN_RE.match(domain):
            raise ValueError(f"line {number}: invalid pattern {pattern!r}")


SMTP_USER_RE = re.compile(r"^([a-z0-9](?:[a-z0-9._+-]{0,62}[a-z0-9])?)@([a-z0-9.-]+):\{BLF-CRYPT\}\$2[aby]\$\d\d\$[./A-Za-z0-9]{53}$")
FAIL2BAN_JAIL = "/etc/fail2ban/jail.d/ravenkeep.conf"


def content_lines(text):
    return [line.strip() for line in text.splitlines() if line.strip() and not line.lstrip().startswith("#")]


def validate_smtp_users(text):
    """Dovecot passwd-file: <local>@<domain>:{BLF-CRYPT}<bcrypt hash>, unique user names."""
    seen = set()
    for number, line in enumerate(content_lines(text), 1):
        match = SMTP_USER_RE.match(line)
        if not match or not DOMAIN_RE.match(match.group(2)):
            raise ValueError(f"entry {number}: expected '<user>@<domain>:{{BLF-CRYPT}}<bcrypt hash>'")
        user = line.split(":", 1)[0]
        if user in seen:
            raise ValueError(f"entry {number}: duplicate user {user}")
        seen.add(user)


def validate_local_domains(text):
    """At least one domain, one per line, no comments (Postfix reads the file as a list)."""
    domains = text.split()
    if not domains:
        raise ValueError("local-domains must not be empty (the node would reject all mail)")
    for domain in domains:
        if not DOMAIN_RE.match(domain):
            raise ValueError(f"invalid domain {domain!r}")


def validate_admin_networks(text):
    for line in content_lines(text):
        try:
            network = ipaddress.ip_network(line, strict=False)
        except ValueError as exc:
            raise ValueError(f"invalid network {line!r}") from exc
        if network.prefixlen < 8:
            raise ValueError(f"network too large: {line!r}")


def reload_postfix():
    subprocess.run(["postfix", "reload"], check=True, capture_output=True)


def update_fail2ban():
    """Rewrite the ignoreip line of the Ravenkeep jail from admin-networks and reload fail2ban."""
    if not os.path.exists(FAIL2BAN_JAIL):
        return
    with open(os.path.join(intake.CONFIG_DIR, "admin-networks"), encoding="utf-8") as fh:
        networks = content_lines(fh.read())
    with open(FAIL2BAN_JAIL, encoding="utf-8") as fh:
        jail = fh.read()
    jail = re.sub(r"(?m)^ignoreip = .*$", "ignoreip = 127.0.0.1/8 ::1 " + " ".join(networks), jail, count=1)
    with open(FAIL2BAN_JAIL + ".tmp", "w", encoding="utf-8") as fh:
        fh.write(jail)
    os.replace(FAIL2BAN_JAIL + ".tmp", FAIL2BAN_JAIL)
    subprocess.run(["fail2ban-client", "reload"], check=True, capture_output=True)


# file name -> (validator, install mode, group, action after a change)
KNOWN_FILES = {
    "allowed-senders": (validate_sender_list, 0o644, "root", None),
    "blocked-senders": (validate_sender_list, 0o644, "root", None),
    "smtp-users": (validate_smtp_users, 0o640, "dovecot", None),
    "local-domains": (validate_local_domains, 0o644, "root", reload_postfix),
    "admin-networks": (validate_admin_networks, 0o644, "root", update_fail2ban),
}


def write_status(status):
    tmp = STATUS_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(status, fh, indent=1)
    os.chmod(tmp, 0o640)
    try:
        import grp
        os.chown(tmp, 0, grp.getgrnam("ravenkeep").gr_gid)
    except (KeyError, PermissionError):
        pass
    os.replace(tmp, STATUS_FILE)


def read_status():
    try:
        with open(STATUS_FILE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def load_bundle():
    """Read and validate the incoming bundle. Returns (hash, {name: bytes})."""
    with open(os.path.join(INCOMING_DIR, "manifest.json"), encoding="utf-8") as fh:
        manifest = json.load(fh)
    bundle_hash, files = manifest.get("hash"), manifest.get("files")
    if not isinstance(bundle_hash, str) or not re.fullmatch(r"[0-9a-f]{64}", bundle_hash) or not isinstance(files, dict):
        raise ValueError("manifest: invalid structure")
    contents = {}
    for name, expected in files.items():
        if name not in KNOWN_FILES:
            raise ValueError(f"manifest: unknown file {name!r}")
        path = os.path.join(INCOMING_DIR, name)
        if os.path.islink(path) or os.path.getsize(path) > MAX_FILE_SIZE:
            raise ValueError(f"{name}: not a regular file or too large")
        with open(path, "rb") as fh:
            data = fh.read()
        if hashlib.sha256(data).hexdigest() != expected:
            raise ValueError(f"{name}: checksum mismatch")
        KNOWN_FILES[name][0](data.decode("utf-8"))
        contents[name] = data
    return bundle_hash, contents


def install(name, data):
    """Install a file atomically. Returns True if the content changed."""
    _validator, mode, group, _action = KNOWN_FILES[name]
    import grp
    target = os.path.join(intake.CONFIG_DIR, name)
    try:
        with open(target, "rb") as fh:
            unchanged = fh.read() == data
    except OSError:
        unchanged = False
    tmp = os.path.join(intake.CONFIG_DIR, f".{name}.tmp")
    with open(tmp, "wb") as fh:
        fh.write(data)
        fh.flush()
        os.fsync(fh.fileno())
    os.chmod(tmp, mode)
    os.chown(tmp, 0, grp.getgrnam(group).gr_gid)
    os.replace(tmp, target)
    return not unchanged


def clear_incoming():
    for name in os.listdir(INCOMING_DIR):
        path = os.path.join(INCOMING_DIR, name)
        if os.path.isfile(path) or os.path.islink(path):
            os.unlink(path)


def main():
    if not os.path.exists(os.path.join(INCOMING_DIR, "manifest.json")):
        return 0
    previous = read_status()
    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    try:
        bundle_hash, contents = load_bundle()
    except Exception as exc:  # noqa: BLE001 – any problem keeps the last valid config
        write_status({**previous, "error": f"{exc}", "error_at": now})
        clear_incoming()
        print(f"rk-apply-config: rejected bundle: {exc}", file=sys.stderr)
        return 1

    changed = [name for name, data in contents.items() if install(name, data)]
    errors = []
    for action in dict.fromkeys(KNOWN_FILES[name][3] for name in changed if KNOWN_FILES[name][3]):
        try:
            action()
        except Exception as exc:  # noqa: BLE001 – files are installed; report the failed reload
            errors.append(f"{action.__name__}: {exc}")
    write_status({"applied_hash": bundle_hash, "applied_at": now, "files": sorted(contents), "changed": changed,
                  "error": "; ".join(errors) or None})
    clear_incoming()
    print(f"rk-apply-config: applied {bundle_hash[:12]} (changed: {', '.join(changed) or 'none'})")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
