#!/usr/bin/python3 -I
"""Postfix policy service (check_policy_service) for the public MX on port 25.

Decides on the envelope sender domain during RCPT TO:
  authenticated client            -> DUNNO (submission is handled elsewhere)
  blocked domain                  -> 550, attempt logged
  allowed domain                  -> DUNNO (message is accepted and checked after DATA)
  unknown domain or null sender   -> 451, attempt logged (metadata only)
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from ravenkeep_mx import intake  # noqa: E402
from ravenkeep_mx.senderauth import domain_of  # noqa: E402

REPLY_UNKNOWN = "451 4.7.1 Sender domain not yet authorized; please retry later"
REPLY_BLOCKED = "550 5.7.1 Sender domain blocked"


def decide(attrs):
    """Return the Postfix action for one policy request."""
    if attrs.get("sasl_username"):
        return "DUNNO"
    sender = attrs.get("sender", "")
    domain = domain_of(sender) if sender else ""
    attempt = {"client_address": attrs.get("client_address"), "client_name": attrs.get("client_name"),
               "helo": attrs.get("helo_name"), "sender": sender, "recipient": attrs.get("recipient"),
               "sender_domain": domain}

    if domain and intake.domain_in_list(domain, intake.read_domain_list(intake.BLOCKED_FILE)):
        intake.log_attempt({**attempt, "result": "blocked"})
        return REPLY_BLOCKED
    if domain and intake.domain_in_list(domain, intake.read_domain_list(intake.ALLOWED_FILE)):
        return "DUNNO"
    intake.log_attempt({**attempt, "result": "unknown_domain" if domain else "null_sender"})
    return REPLY_UNKNOWN


def main():
    attrs = {}
    for line in sys.stdin:
        line = line.rstrip("\n")
        if line:
            key, _, value = line.partition("=")
            attrs[key] = value
            continue
        try:
            action = decide(attrs)
        except Exception as exc:  # noqa: BLE001 – never let a bug accept or bounce mail
            sys.stderr.write(f"rk-policy error: {exc}\n")
            action = "451 4.3.0 Temporary policy error"
        sys.stdout.write(f"action={action}\n\n")
        sys.stdout.flush()
        attrs = {}


if __name__ == "__main__":
    main()
